# PostgreSQL connection string — required.
# Azure: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# Local: postgresql://localhost:5432/lumiere
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this app — http://localhost:3000 locally, https://<host> in production.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in codes. Development prints codes to the server console instead.
# Production hides email sign-in until both are set (sender on a Resend-verified domain).
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Sundew <noreply@mail.example.com>
# Sign-up gate: defaults to open in development, closed in production.
# AUTH_SIGNUP_ENABLED=false

# OpenAI API key — required for S2 onwards (word lookup, task generation, feedback).
OPENAI_API_KEY=sk-...

# Private Cloudflare R2 media. The app exchanges the database's /media/... paths
# for short-lived download URLs only after the user has authenticated.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-read-only-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-read-only-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=sundew-media

# Optional: override the default model. Defaults are conservative.
# OPENAI_MODEL_LOOKUP=gpt-4o-mini
# OPENAI_MODEL_TASK=gpt-4o
# OPENAI_MODEL_FEEDBACK=gpt-4o

# TCF import pipeline — local paths to your own exam material.
# Nothing under these paths is ever committed; the scripts read them at runtime.
# TCF_LISTENING_DIR=/path/to/listening-pdfs-and-audio
# TCF_READING_DIR=/path/to/reading-questions
# TCF_READING_MHTML_SUBDIR=mhtml        # subfolder of TCF_READING_DIR holding .mhtml exports
# TCF_READING_PDF40=test-40.pdf         # filename of the text-PDF test inside TCF_READING_DIR
# TCF_SAMPLE_PDF=/path/to/one-test.pdf  # single PDF used by the parser debug scripts
